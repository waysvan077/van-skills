# ~/.airdrop-agent/env.example — copy to .env (0600). Never commit real secrets.
# The agent can print this file's *names* but never the values.

# --- Vault (encrypts every key, seed and session). Long random string, back it up offline.
VAULT_PASSWORD=change-me-long-random-passphrase

# --- Mode: safe | balanced | turbo  (override at runtime with `aa mode`)
AA_MODE=balanced

# --- Telegram: user session (dedicated SIM) from https://my.telegram.org
TG_API_ID=1234567
TG_API_HASH=replace_me
TG_MIN_DELAY=2
TG_MAX_FLOOD_WAIT=900
# TG_SESSION_HINT=radar account is a separate identity

# --- Reporting bot → your private group topic (gate codes land here)
TG_REPORT_BOT_TOKEN=
TG_REPORT_CHAT_ID=
TG_REPORT_TOPIC_ID=
TG_OWNER_USER_ID=
NOTIFY_DIGEST=0

# --- Email inbox (Gmail app password works; custom domain IMAP works)
AGENT_EMAIL=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
AGENT_PHONE=

# --- X
X_BEARER_TOKEN=
X_API_FOLLOW_MODE=browser

# --- Discord user token fallback (normally captured by `aa dc login`)
DISCORD_USER_TOKEN=

# --- RPC overrides (public defaults live in policy.yaml)
RPC_SEPOLIA=
RPC_BASE_SEPOLIA=
RPC_ARB_SEPOLIA=
RPC_OP_SEPOLIA=
RPC_MONAD_TESTNET=
RPC_SOL_DEVNET=
RPC_BASE=
RPC_ARB=
RPC_SOL=

# --- Browser
BROWSER_HEADLESS=1
BROWSER_TIMEOUT_MS=45000
BROWSER_NAV_TIMEOUT_MS=60000
BROWSER_USE_EXTENSIONS=0
BROWSER_LOCALE=en-US
TZ=Asia/Jakarta
# BROWSER_PROXY=http://user:pass@host:port   (one residential IP per identity)

# --- Captcha (optional; without it the quest parks and screenshot-hands-off)
# turnstile tokens also work for the Cloudflare layer, with action/cdata passed through
CAPTCHA_PROVIDER=
CAPTCHA_API_KEY=

# --- Cloudflare clearance
CF_ENABLED=1
CF_WAIT_SECONDS=28
CF_TTL_MINUTES=45
CF_ASSIST_SECONDS=300
# FLARESOLVERR_URL=http://127.0.0.1:8191   (headless servers / datacenter IPs)

# --- Session persistence (one profile per identity + encrypted state mirror)
SESSION_AUTOSAVE=1
SESSION_RESTORE=1
SESSION_STATE_DAYS=14
# BROWSER_PROFILE=main
# BROWSER_SEPARATE_PROFILES=0
# BROWSER_UA=

# --- LLM for chat/classifier (any OpenAI-compatible endpoint)
GRIND_LLM_BASE_URL=
GRIND_LLM_API_KEY=
GRIND_LLM_MODEL=
LLM_MOCK=0
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# --- Radar
RADAR_TG_SYNC=0
X_SEARCH_ENABLED=0

# --- SMS for account signup (optional)
SMS_PROVIDER=
SMS_API_KEY=

LOG_LEVEL=INFO
